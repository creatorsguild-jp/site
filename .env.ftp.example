# ============================================================
# FTP デプロイ認証情報テンプレート — creatorsguild.info
# 使い方:
#   cp .env.ftp.example .env.ftp
#   # .env.ftp に実値を記入する（.env.ftp は .gitignore 済み）
# 重要: 実際の認証情報は .env.ftp にのみ書き、絶対に Git にコミットしないこと。
# ============================================================
FTP_HOST='sv3057.xserver.jp'                      # XServer の FTP ホスト
FTP_USER='master@creatorsguild.info'              # FTP アカウント
FTP_PASS='your-ftp-password'                      # FTP パスワード
FTP_REMOTE_DIR='public_html'                      # アップロード先（公開 docroot, FTPログイン直下）
