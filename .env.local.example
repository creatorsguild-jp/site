# ============================================================
# フロントエンド ビルド時環境変数テンプレート — creatorsguild.info
# 使い方:
#   cp .env.local.example .env.local
#   # .env.local に実値を記入する（.env.local は .gitignore 済み）
#   npm run build   # ビルド時にこの値が静的 JS へ埋め込まれる
# ============================================================

# reCAPTCHA v3 サイトキー（公開値・フロントに埋め込まれる）。
#   Google reCAPTCHA 管理画面で「reCAPTCHA v3」として登録して取得する。
#   未設定なら /contact フォームは reCAPTCHA を読み込まず、サーバ側も検証スキップで動作する。
#   ※ シークレットキーはこちらではなく public/api/contact.config.php（サーバ側）に置く。
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
